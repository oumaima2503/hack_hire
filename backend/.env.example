# ── Storage ── leave both empty to run with the in-memory demo store.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_… or the legacy service_role JWT). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# STORAGE=memory forces the in-memory store even when Supabase keys are set.
# STORAGE=memory
# In-memory mode only: keep accounts/progress across restarts.
MEMORY_DB_PATH=.data/dev-db.json

# ── Auth ── required in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12
# true when served over HTTPS
COOKIE_SECURE=false
APP_ENV=development

# ── AI tutor (Google Gemini) ── backend only, never in the React app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Points (optional overrides) ──
# POINTS_CONFIG={"lesson_completed": 10, "game_completed": 20, "correct_answer": 5, "challenge_completed": 30, "rug_created": 25, "video_watched": 5, "daily_streak": 15}
# POINTS_PER_LEVEL=100

FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
